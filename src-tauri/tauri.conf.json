{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Raguia Agent",
  "version": "0.1.6",
  "identifier": "com.raguia.agent",
  "build": {
    "frontendDist": "../wizard",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2QjUzNkZERTFFODk4QzEKUldUQm1PamgvVGExTmxTYmR3TzlBL1dXdWl0RjhyUGlXRVB0dEdHOWlPYXdxTTIzcDdGTTdWT20K",
      "endpoints": [
        "https://raguia.valentin-fiess.fr/api/agent/updates/{{target}}-{{arch}}/{{current_version}}"
      ],
      "dialog": true
    }
  }
}
