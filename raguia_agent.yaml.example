# Configuration de l'agent Raguia
# Copier vers ~/.raguia/config.yaml ou definir RAGUIA_AGENT_CONFIG
#
# NOTE : Ce fichier ne contient plus de jeton d'authentification.
# La connexion est etablie via le wizard de premier lancement
# (slug client + mot de passe portail). La session est ensuite
# stockee de facon securisee dans le trousseau OS (Keychain / Credential Locker).
#
# Pour reconfigurer : clic droit sur l'icone -> Se connecter / Reconnecter...

api_base: "https://raguia.valentin-fiess.fr"
client_slug: "mon-client"

# Dossier parent dans lequel le dossier RAGUIA sera cree / surveille
watch_parent: "/Users/moi/Documents"

root_folder_name: "RAGUIA"

poll_interval_seconds: 30
stability_seconds: 2

# Synchro auto : au moins burst_threshold fichier(s) en attente + cooldown ecoule.
sync_cooldown_seconds: 900
burst_threshold: 1
max_files_per_cycle: 100

dry_run: false
secure_token_storage: true
structured_logging: true
